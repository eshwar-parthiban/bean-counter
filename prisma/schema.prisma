generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Member {
  id           String             @id @default(cuid())
  name         String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  nickname     String?
  accounts     Account[]
  transactions Transaction[]      @relation("AssignedTo")
  splits       TransactionSplit[]
}

model Account {
  id                 String              @id @default(cuid())
  name               String
  bankName           String
  accountNumber      String
  nickname           String?
  currency           Currency
  type               AccountType         @default(CURRENT)
  memberId           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  member             Member              @relation(fields: [memberId], references: [id])
  extractionPatterns ExtractionPattern[]
  importJobs         ImportJob[]
}

model ImportJob {
  id           String        @id @default(cuid())
  filename     String
  status       ImportStatus  @default(PROCESSING)
  accountId    String
  rawFilePath  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  account      Account       @relation(fields: [accountId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id                 String             @id @default(cuid())
  date               DateTime
  description        String
  importJobId        String
  rawData            Json
  contentHash        String             @unique
  amount             Decimal
  currency           Currency
  amountGbp          Decimal
  notes              String?
  status             TransactionStatus  @default(DRAFT)
  categoryId         String?
  assignedToMemberId String?
  isSplit            Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  assignedToMember   Member?            @relation("AssignedTo", fields: [assignedToMemberId], references: [id])
  category           Category?          @relation(fields: [categoryId], references: [id])
  importJob          ImportJob          @relation(fields: [importJobId], references: [id])
  splits             TransactionSplit[]
}

model TransactionSplit {
  id                 String      @id @default(cuid())
  transactionId      String
  amount             Decimal
  amountGbp          Decimal
  categoryId         String
  assignedToMemberId String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  assignedToMember   Member      @relation(fields: [assignedToMemberId], references: [id])
  category           Category    @relation(fields: [categoryId], references: [id])
  transaction        Transaction @relation(fields: [transactionId], references: [id])
}

model Category {
  id           String             @id @default(cuid())
  name         String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  transactions Transaction[]
  splits       TransactionSplit[]
}

model ExtractionPattern {
  id        String   @id @default(cuid())
  accountId String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account   Account  @relation(fields: [accountId], references: [id])
}

enum AccountType {
  CURRENT
  SAVINGS
  CREDIT_CARD
}

enum Currency {
  GBP
  INR
  SGD
  USD
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum TransactionStatus {
  DRAFT
  POSTED
}
